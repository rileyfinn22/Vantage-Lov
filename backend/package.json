{
	"name": "backend",
	"type": "module",
	"scripts": {
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"dev": "USE_PGLITE=true PORT=5176 HOST=localhost:5176 NODE_ENV=development TENANT_NAME=dev TRANSCRIPTION_SERVICE=elevenlabs tsx src/node.ts",
		"dev:pglite": "USE_PGLITE=true PORT=5176 NODE_OPTIONS='--inspect=9229' HOST=localhost:5176 NODE_ENV=development TENANT_NAME=bedp TRANSCRIPTION_SERVICE=elevenlabs tsx src/node.ts",
		"dev:postgres": "PORT=5100 NODE_ENV=development TENANT_NAME=dev tsx src/node.ts",
		"build": "npx mastra build --dir ./src/mastra",
		"build:tsc": "tsc -b",
		"test": "vitest",
		"test:run": "vitest run",
		"test:integration": "RUN_INTEGRATION_TESTS=true vitest"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.71.2",
		"@electric-sql/pglite": "^0.3.14",
		"@elevenlabs/elevenlabs-js": "^2.22.0",
		"@ffmpeg-installer/ffmpeg": "^1.1.0",
		"@google-cloud/storage": "^7.17.3",
		"@google-cloud/video-transcoder": "^4.4.1",
		"@hono/node-server": "^1.19.6",
		"@hono/zod-validator": "^0.7.4",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.207.0",
		"@opentelemetry/auto-instrumentations-node": "^0.66.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.207.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.207.0",
		"@opentelemetry/instrumentation-pino": "^0.54.0",
		"@opentelemetry/resources": "^2.2.0",
		"@opentelemetry/sdk-logs": "^0.207.0",
		"@opentelemetry/sdk-node": "^0.206.0",
		"@opentelemetry/semantic-conventions": "^1.38.0",
		"@sentry/node": "^10.38.0",
		"@types/fluent-ffmpeg": "^2.1.28",
		"better-auth": "^1.3.34",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.7",
		"es-toolkit": "^1.41.0",
		"ffprobe-installer": "^2.1.5",
		"fluent-ffmpeg": "^2.1.3",
		"hono": "4.8.9",
		"pino": "^9.14.0",
		"pino-opentelemetry-transport": "^1.1.0",
		"postgres": "^3.4.7",
		"tsx": "^4.20.6",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"@faker-js/faker": "^9.9.0",
		"@types/node": "^24.10.0",
		"drizzle-kit": "^0.31.6",
		"pino-pretty": "^13.1.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
