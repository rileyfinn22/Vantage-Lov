# k6 Load Test Configuration
# Copy this file to .env and update with your actual values

# Backend URL
# Use localhost for local testing, or your staging/production URL
BASE_URL=https://localhost:5025

# Test User Credentials (Optional)
# By default, tests use the 6 seeded users from backend/utils/seed.ts
# All seeded users have password: brazil-tree-fire
# Seeded users: alex@, bob@, robert@, lee@, angela@, admin@ @v.alexw.codes
#
# You can override to use a single user for all VUs by uncommenting:
# TEST_USER_EMAIL=alex@v.alexw.codes
# TEST_USER_PASSWORD=brazil-tree-fire

# Optional: Override test parameters
# Uncomment and modify as needed

# Custom VU (Virtual User) count
# K6_VUS=15

# Custom test duration
# K6_DURATION=90s

# k6 Cloud settings (if using k6 Cloud)
# K6_CLOUD_TOKEN=your_cloud_token
# K6_CLOUD_PROJECT_ID=your_project_id